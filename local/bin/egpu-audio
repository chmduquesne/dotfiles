#!/bin/bash
# egpu-audio: keep the sound on the physical monitor (the screen with speakers) while it
# changes input.
#   egpu-audio follow   -- command [args...]   run command (switches the monitor to the eGPU),
#                                              then move the sound to the eGPU's audio sink
#   egpu-audio unfollow -- command [args...]   run command (switches it back), then restore
#                                              the old sink unless the default changed meanwhile
#
# Only a default sink that is an HDMI/DisplayPort monitor is moved; speakers, Bluetooth, USB
# are left alone. The exit code is the command's; if it fails, nothing is moved.
#
# The monitor's sinks flap while it changes input (set-default-sink fails with "No such
# entity"), so the eGPU sink is looked up BEFORE the command and set after it, with retries.
#
# State: $XDG_RUNTIME_DIR/egpu-audio.state, "<old sink> <new sink>".
# Log: journalctl -t egpu-audio

RT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
STATE=$RT/egpu-audio.state

log() { logger -t egpu-audio -- "$*" 2>/dev/null || true; }

# The eGPU's sink with an available port, whichever HDMI or DisplayPort connector it is.
egpu_sink() {
    local addr
    addr=$(egpu-card --audio) || return 1
    pactl --format=json list sinks 2>/dev/null | jq -r --arg bus "pci-$addr" '
        first(.[] | select(.properties["device.bus_path"] == $bus
                           and any(.ports[]; .availability == "available")) | .name) // empty'
}

# Whether sink $1 is on a monitor: PulseAudio types HDMI and DisplayPort ports alike "HDMI".
is_physical_monitor_sink() {
    pactl --format=json list sinks 2>/dev/null | jq -e --arg name "$1" '
        .[] | select(.name == $name) | .active_port as $p
            | any(.ports[]; .name == $p and .type == "HDMI")' >/dev/null
}

# set_default <sink-or-"">: retry for 6 s; an empty name means look up the eGPU sink each time
set_default() {
    local sink=$1 i
    for i in $(seq 1 12); do
        [ -n "$sink" ] || sink=$(egpu_sink)
        if [ -n "$sink" ] && pactl set-default-sink "$sink" 2>/dev/null; then return 0; fi
        sink=$1; sleep 0.5
    done
    return 1
}

follow() {
    local old new rc
    old=$(pactl get-default-sink 2>/dev/null)
    if is_physical_monitor_sink "$old"; then
        new=$(egpu_sink)
        [ -n "$new" ] || log "no eGPU audio sink available; audio stays on $old"
    else
        log "default sink ${old:-?} is not a physical monitor; left alone"
    fi
    "$@"; rc=$?
    [ "$rc" = 0 ] && [ -n "$new" ] || return "$rc"
    if set_default "$new"; then
        echo "$old $new" > "$STATE"
        log "default sink $old -> $new"
    else
        echo "egpu-audio: could not set the eGPU audio sink; sound stays on $old" >&2
    fi
    return 0
}

unfollow() {
    local old new rc cur
    "$@"; rc=$?
    [ -r "$STATE" ] || return "$rc"
    read -r old new < "$STATE"; rm -f "$STATE"
    cur=$(pactl get-default-sink 2>/dev/null)
    if [ "$cur" != "$new" ]; then
        log "default sink is now ${cur:-?}, not $new; not restoring $old"
    elif set_default "$old"; then
        log "default sink $new -> $old"
    else
        echo "egpu-audio: could not restore the audio sink $old" >&2
    fi
    return "$rc"
}

cmd=$1
if { [ "$cmd" != follow ] && [ "$cmd" != unfollow ]; } || [ "$2" != -- ] || [ $# -lt 3 ]; then
    echo "usage: egpu-audio follow|unfollow -- command [args...]" >&2
    exit 2
fi
shift 2
for dep in pactl jq egpu-card; do
    command -v "$dep" >/dev/null || { echo "egpu-audio: $dep not found" >&2; exit 1; }
done
"$cmd" "$@"
