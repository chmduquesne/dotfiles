#!/bin/bash
# egpu-card: find the eGPU.
#   egpu-card           print its DRM card name (card1)
#   egpu-card --pci     print its PCI address (0000:a6:00.0)
#   egpu-card --audio   print the PCI address of its audio function (0000:a6:00.1)
# Prints nothing and exits 1 if there is no eGPU. The card name also needs a driver bound to
# the GPU (the DRM card only exists then): a GPU that is present but has none still answers
# --pci and --audio, but not the card name.
#
# The eGPU is the display-class PCI device the kernel flags "removable" (behind an external
# port such as Thunderbolt), whatever its vendor or card number. It assumes a single eGPU is
# plugged in. EGPU_CARD (e.g. card1) overrides the detection. Testing hook: EGPU_SYSFS
# (instead of /sys).

SYS=${EGPU_SYSFS:-/sys}

case $1 in
    "") mode=card ;;
    --pci) mode=pci ;;
    --audio) mode=audio ;;
    *) echo "usage: egpu-card [--pci|--audio]" >&2; exit 2 ;;
esac

if [ -n "$EGPU_CARD" ]; then
    [[ $EGPU_CARD =~ ^card[0-9]+$ ]] || exit 1
    gpu=$(readlink -f "$SYS/class/drm/$EGPU_CARD/device" 2>/dev/null)
else
    for dev in "$SYS"/bus/pci/devices/*; do
        [[ $(< "$dev/class") == 0x03* && $(< "$dev/removable") == removable ]] || continue
        gpu=$(readlink -f "$dev"); break
    done 2>/dev/null
fi
[ -d "$gpu" ] || exit 1

case $mode in
    card)
        for c in "$gpu"/drm/card*; do
            [[ $c =~ /card[0-9]+$ ]] && { echo "${c##*/}"; exit 0; }
        done
        exit 1 ;;
    pci) echo "${gpu##*/}" ;;
    audio)
        # the class 0403 function in the same PCI slot
        for dev in "${gpu%.*}".*; do
            [[ $(< "$dev/class") == 0x0403* ]] && { echo "${dev##*/}"; exit 0; }
        done 2>/dev/null
        exit 1 ;;
esac
