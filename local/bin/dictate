#!/usr/bin/env bash
set -u
set -o pipefail
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/dictate"
RECORDING_FILE="$RUNDIR/rec.wav"
PID_FILE="$RUNDIR/pid"
KEEPALIVE_FILE="$RUNDIR/keepalive"
LANG_FILE="$RUNDIR/lang"
ERROR_FILE="$RUNDIR/whisper.err"
BUSY_FILE="$RUNDIR/busy"      # exists while transcribing: no new recording can start
LANGS=(auto en fr de)
MAX_SECONDS=${DICTATE_MAX_SECONDS:-120}   # a recording is stopped (and transcribed) after this long
TIMER_FILE="$RUNDIR/timer"
WAYBAR_SIGNAL=11
MODELS="$HOME/.local/share/whisper"
BIN="$HOME/.local/bin"
RADV_ICD=/usr/share/vulkan/icd.d/radeon_icd.json
mkdir -p "$RUNDIR"

refresh() { pkill -RTMIN+$WAYBAR_SIGNAL waybar 2>/dev/null || true; }
cur_lang() { cat "$LANG_FILE" 2>/dev/null || echo auto; }

cycle_lang() {  # cycle_lang <+1|-1>
  local cur i n=${#LANGS[@]}; cur=$(cur_lang)
  for i in "${!LANGS[@]}"; do [ "${LANGS[$i]}" = "$cur" ] && break; done
  [ "${LANGS[$i]}" = "$cur" ] || i=0
  echo "${LANGS[$(( (i + $1 + n) % n ))]}" > "$LANG_FILE"
}

status() {
  local lang state class icon tip
  lang=$(cur_lang)
  if [ -f "$BUSY_FILE" ]; then state=transcribing; icon="⏳"
  elif [ -f "$PID_FILE" ]; then state=recording; icon="🔴"
  else state=idle; icon="✍️"; fi
  class=$state
  tip="Dictation: $state"$'\n'"Language: $lang"$'\n'"Click: start/stop - Scroll: language"
  jq -nc --arg text "$icon ${lang^^}" --arg class "$class" --arg tooltip "$tip" \
    '{text: $text, class: $class, tooltip: $tooltip}'
}

fail() { notify-send -u low -i audio-input-microphone "Dictation failure" "$1"; }

# Whisper hallucinates words ("you") on silence, so detect a silent recording first.
is_silent() {
  local max
  max=$(ffmpeg -nostdin -hide_banner -i "$RECORDING_FILE" -af volumedetect -f null - 2>&1 | sed -n 's/.*max_volume: \(-\?[0-9.]*\) dB.*/\1/p')
  [ -z "$max" ] || awk -v m="$max" 'BEGIN { exit !(m < -50) }'
}

# A Bluetooth headset mic only delivers samples (otherwise digital silence) while its sink is
# also streaming, so play inaudible silence while recording.
keepalive_start() {
  case "$(pactl get-default-source)" in bluez_input.*) ;; *) return 0 ;; esac
  pw-cat -p --raw --format s16 --rate 48000 --channels 1 - < /dev/zero &
  echo $! > "$KEEPALIVE_FILE"
}
keepalive_stop() {
  [ -f "$KEEPALIVE_FILE" ] || return 0
  kill "$(cat "$KEEPALIVE_FILE")" 2>/dev/null; rm -f "$KEEPALIVE_FILE"
}

# wtype makes sway switch to its own keymap, and only the next change of keyboard setup switches
# back. Until then clients (Solaar) cannot look up XF86AudioRecord, so its key press is lost.
# Re-applying the keyboard config (a no-op setting) makes sway rebuild the current keymap.
restore_keymap() { swaymsg -q input type:keyboard events enabled; }

clean() { tr '\n' ' ' | sed 's/^ *//; s/ *$//'; }

run_igpu() {  # AMD driver only: the NVIDIA driver is never loaded
  [ -f "$RADV_ICD" ] || return 1  # without it whisper-cli-vulkan silently runs the large model on the CPU
  VK_DRIVER_FILES="$RADV_ICD" "$BIN/whisper-cli-vulkan" \
    -m "$MODELS/ggml-large-v3-turbo.bin" -f "$RECORDING_FILE" \
    -l "$LANG_OPT" -nt -np -dev 0 2>/dev/null | clean
}
run_cpu() {
  "$BIN/whisper-cli" -m "$MODELS/ggml-small.bin" -f "$RECORDING_FILE" \
    -l "$LANG_OPT" -nt -np -t 6 2>"$ERROR_FILE" | clean
}

case "${1:-}" in
  start)
    [ -f "$PID_FILE" ] && exit 0
    [ -f "$BUSY_FILE" ] && exit 0
    keepalive_start
    pw-record --rate 16000 --channels 1 "$RECORDING_FILE" &
    echo $! > "$PID_FILE"
    # Safety net for a missed key release: stop by ourselves, unless this recording is over.
    setsid bash -c 'sleep "$1"; [ "$(cat "$2" 2>/dev/null)" = "$3" ] && exec "$4" stop' \
      _ "$MAX_SECONDS" "$PID_FILE" "$!" "$0" >/dev/null 2>&1 &
    echo $! > "$TIMER_FILE"
    refresh
    ;;
  toggle)
    if [ -f "$PID_FILE" ]; then exec "$0" stop; else exec "$0" start; fi
    ;;
  stop)
    [ -f "$PID_FILE" ] || exit 0
    pid=$(cat "$PID_FILE"); rm -f "$PID_FILE"
    kill -INT "$pid" 2>/dev/null
    while kill -0 "$pid" 2>/dev/null; do sleep 0.05; done
    keepalive_stop
    if [ -f "$TIMER_FILE" ]; then  # when the timer itself called us ($$ is its pid), do not kill it
      timer=$(cat "$TIMER_FILE"); rm -f "$TIMER_FILE"
      [ "$timer" = "$$" ] || kill -- "-$timer" 2>/dev/null  # its whole session, sleep included
    fi
    LANG_OPT=$(cur_lang)
    touch "$BUSY_FILE"; refresh
    trap 'rm -f "$BUSY_FILE"; refresh' EXIT

    if is_silent; then
      fail "No sound captured: check the microphone ($(pactl get-default-source))"
      exit 0
    fi
    text=$(run_igpu || run_cpu); status=$?  # the CPU only takes over when the iGPU run fails
    if [ -n "$text" ]; then
      printf '%s' "$text" | wl-copy
      wtype -- "$text"
      restore_keymap
    elif [ "$status" != 0 ]; then
      fail "whisper-cli failed: $(tail -n 1 "$ERROR_FILE")"
    else
      fail "Nothing recognized"
    fi
    ;;
  status) status ;;
  lang)
    if [ -n "${2:-}" ]; then echo "$2" > "$LANG_FILE"; else cycle_lang 1; fi
    refresh
    ;;
  next-lang) cycle_lang 1; refresh ;;
  prev-lang) cycle_lang -1; refresh ;;
  *) echo "usage: dictate start|stop|toggle|status|lang [auto|en|fr|de]|next-lang|prev-lang" >&2; exit 1 ;;
esac
