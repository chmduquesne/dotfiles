#!/bin/bash
# lgmonitor-input: read or select the input of an LG monitor over DDC/CI (ddcutil).
#   lgmonitor-input get          print the active input (a name from the table, or "unknown")
#   lgmonitor-input list         print the known input names (no DDC access)
#   lgmonitor-input find <card>  print the input the monitor reaches <card> (e.g. card1)
#                                through; exit 1 if none. Rescans if the cache is over 30 s old.
#   lgmonitor-input set <input>  switch to <input> and wait until the monitor confirms
#   -v (before the command)      also echo the log lines to stderr
#
# Exit codes: 0 ok, 1 could not switch, 2 usage or unknown input, 3 monitor unreadable.
# Log: journalctl -t lgmonitor-input
#
# Verified only on the LG UltraFine 27UN83A-W; other models may need other values (see the
# table). On this monitor:
#  - input feature 0x60 is ignored; the vendor feature 0xF4 (I2C source address 0x50, never
#    --noverify) switches the input;
#  - feature 0xF8, last byte, reports the active input (the "sensor" in the table);
#  - the command only works over the link of the input being left, hence the table ties each
#    input to the DRM connector whose DDC bus reaches the monitor through it.
#
# Speed: one `ddcutil detect` scan (~1.9 s) finds the buses; they are cached in
# $XDG_RUNTIME_DIR/lgmonitor-input.buses (delete it to rescan) and validated by reading the
# sensor, which is polled every 0.4 s. If the cached buses fail, it rescans once. The first
# link gets the whole confirmation timeout, fallbacks half, so a monitor that ignores us
# fails after ~15 s.

# name  xF4-value  F8-sensor  regex of the DRM connector whose DDC link belongs to this input
# (for a DisplayPort cable on the eGPU, widen the hdmi1 pattern, e.g. ^card1-(HDMI|DP))
# An input with nothing connected has no DDC link: write "-" for the sensor and pattern. We can
# switch to it over another link but not read it back, so the switch is not verified.
INPUTS=(
    "usbc   x00D1  xff  ^card0-DP"
    "hdmi1  x0090  x00  ^card1-HDMI"
    "dp     x00D0  -    -"
    "hdmi2  x0091  -    -"
)

RT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
CACHE=$RT/lgmonitor-input.buses
CONFIRM_TIMEOUT=10
VERBOSE=

declare -A VAL SENSOR PATTERN BUS CONN
NAMES=()
for row in "${INPUTS[@]}"; do
    read -r n v s p <<< "$row"
    [ "$s" = - ] && s=; [ "$p" = - ] && p=
    NAMES+=("$n"); VAL[$n]=$v; SENSOR[$n]=$s; PATTERN[$n]=$p
done

log() {
    logger -t lgmonitor-input -- "$*" 2>/dev/null || true
    [ -n "$VERBOSE" ] && echo "lgmonitor-input: $*" >&2
    return 0
}
die() { echo "lgmonitor-input: $1" >&2; exit "${2:-1}"; }

show_buses() {
    local n
    for n in "${NAMES[@]}"; do
        [ -n "${PATTERN[$n]}" ] && printf '%s=%s ' "$n" "${BUS[$n]:-?}"
    done
}

# --- bus discovery and cache --------------------------------------------------------------
scan() {
    local out pairs n pair
    out=$(ddcutil detect --brief 2>/dev/null) || true
    # "<connector> <bus>" for every valid display
    pairs=$(printf '%s\n' "$out" | awk '
        /^Display [0-9]+/  { valid = 1; next }
        /^Invalid display/ { valid = 0; next }
        /I2C bus:/         { bus = $3; sub("/dev/i2c-", "", bus) }
        /DRM connector:/   { if (valid) print $3, bus }')
    BUS=(); CONN=()
    for n in "${NAMES[@]}"; do
        [ -n "${PATTERN[$n]}" ] || continue
        pair=$(printf '%s\n' "$pairs" | awk -v p="${PATTERN[$n]}" '$1 ~ p { print $1, $2; exit }')
        CONN[$n]=${pair% *}; BUS[$n]=${pair#* }
        [ -n "$pair" ] || BUS[$n]=
    done
    mkdir -p "$RT" 2>/dev/null
    { for n in "${NAMES[@]}"; do echo "$n ${BUS[$n]} ${CONN[$n]}"; done; } > "$CACHE.$$" 2>/dev/null \
        && mv -f "$CACHE.$$" "$CACHE"
    log "scan: $(show_buses)"
}

# 0 only if every input that has a link has a cached bus
load_cache() {
    local n b c
    [ -r "$CACHE" ] || return 1
    BUS=(); CONN=()
    while read -r n b c; do [ -n "$n" ] && { BUS[$n]=$b; CONN[$n]=$c; }; done < "$CACHE"
    for n in "${NAMES[@]}"; do
        [ -z "${PATTERN[$n]}" ] || [ -n "${BUS[$n]}" ] || return 1
    done
    return 0
}

# --- reading the monitor ------------------------------------------------------------------
# The F8 sensor byte seen over bus $1; nothing if that link does not answer.
read_f8() {
    [ -n "$1" ] || return 1
    local line
    line=$(timeout 4 ddcutil --bus "$1" -t getvcp f8 2>/dev/null | head -1)
    case "$line" in "VCP F8 CNC "*) echo "${line##* }" ;; esac
}

name_of() {
    local n
    for n in "${NAMES[@]}"; do [ "${SENSOR[$n]}" = "$1" ] && { echo "$n"; return; }; done
}

# Active input name, "unknown" if the sensor value is not in the table, nothing if no link answers.
current_input() {
    local n s r
    for n in "${NAMES[@]}"; do
        s=$(read_f8 "${BUS[$n]}")
        if [ -n "$s" ]; then r=$(name_of "$s"); echo "${r:-unknown}"; return 0; fi
    done
}

# Poll the sensor until it shows input $1, for at most $2 seconds (default: the timeout).
wait_for() {
    local want=${SENSOR[$1]} end=$((SECONDS + ${2:-$CONFIRM_TIMEOUT})) n s order
    order=("$1"); for n in "${NAMES[@]}"; do [ "$n" != "$1" ] && order+=("$n"); done
    while [ "$SECONDS" -lt "$end" ]; do
        for n in "${order[@]}"; do
            s=$(read_f8 "${BUS[$n]}")
            [ "$s" = "$want" ] && return 0
        done
        sleep 0.4
    done
    return 1
}

# --- switching ----------------------------------------------------------------------------
attempt() {   # attempt <target>: 0 when the monitor confirms the target input
    local target=$1 cur n bus order=()
    cur=$(current_input)
    [ -n "$cur" ] || { log "cannot read the current input"; return 1; }
    if [ "$cur" = "$target" ]; then log "already on $target"; return 0; fi
    # Send over the link of the input we are leaving first, then over the others.
    [ "$cur" != unknown ] && order+=("$cur")
    for n in "${NAMES[@]}"; do [ "$n" != "$cur" ] && order+=("$n"); done
    local wait=$CONFIRM_TIMEOUT
    for n in "${order[@]}"; do
        bus=${BUS[$n]}; [ -n "$bus" ] || continue
        log "$cur -> $target: setvcp xF4 ${VAL[$target]} over the $n link (bus $bus)"
        ddcutil --bus "$bus" setvcp xF4 "${VAL[$target]}" --i2c-source-addr=x50 >/dev/null 2>&1
        if [ -z "${SENSOR[$target]}" ]; then
            # nothing to confirm against: send once and trust it
            sleep 1
            log "sent $target (cannot be verified)"; return 0
        fi
        if wait_for "$target" "$wait"; then log "confirmed $target"; return 0; fi
        wait=$(( CONFIRM_TIMEOUT / 2 )); [ "$wait" -ge 2 ] || wait=2
    done
    return 1
}

cmd_set() {
    local target=$1
    [ -n "$target" ] && [ -n "${VAL[$target]}" ] || die "unknown input '$target' (known: ${NAMES[*]})" 2
    local before=
    if load_cache; then
        attempt "$target" && return 0
        before=$(show_buses)
        log "the cached buses did not work; rescanning"
    fi
    scan
    # same buses as before: retrying cannot help
    [ -n "$before" ] && [ "$(show_buses)" = "$before" ] && die "could not switch to $target" 1
    attempt "$target" && return 0
    die "could not switch to $target" 1
}

cmd_get() {
    local cur
    if load_cache; then cur=$(current_input); fi
    if [ -z "$cur" ]; then scan; cur=$(current_input); fi
    [ -n "$cur" ] || die "cannot read the monitor (is it on, is DDC/CI enabled?)" 3
    echo "$cur"
    [ "$cur" != unknown ]
}

cmd_find() {
    local card=$1 n age
    [ -n "$card" ] || usage
    age=$(( $(date +%s) - $(stat -c %Y "$CACHE" 2>/dev/null || echo 0) ))
    # a cable swap takes longer than 30 s, so a younger cache is still right
    if [ "$age" -ge 30 ] || ! load_cache; then scan; fi
    for n in "${NAMES[@]}"; do
        case "${CONN[$n]}" in "$card"-*) echo "$n"; return 0 ;; esac
    done
    return 1
}

usage() {
    echo "usage: lgmonitor-input [-v] get | list | find <card> | set <input>   (inputs: ${NAMES[*]})" >&2
    exit 2
}

[ "$1" = -v ] && { VERBOSE=1; shift; }
[ "$1" = list ] && { printf '%s\n' "${NAMES[@]}"; exit 0; }
command -v ddcutil >/dev/null || die "ddcutil not found" 3
case "$1" in
    get)  cmd_get ;;
    find)  cmd_find "$2" ;;
    set)  cmd_set "$2" ;;
    *)    usage ;;
esac
