#!/bin/bash
# Manage the Thunderbolt eGPU (NVIDIA): report its state to waybar and detach it cleanly.
#   waybar-egpu status          JSON for a waybar custom module
#   waybar-egpu detach [-f] [-y]  confirm, then cleanly detach so the cable can be pulled
#       -f  kill processes still using the GPU
#       -y  skip the confirmation dialog

SERVICES="ollama nvidia-persistenced"

# Journal logging, for post-mortems: journalctl -t waybar-egpu. Never fails the script.
jlog() { logger -t waybar-egpu -- "$*" 2>/dev/null || true; }

# ---- privileged part (runs as root, no UI) ---------------------------------
if [ "$1" = "--root" ]; then
    force=$2
    jlog "detach start (force=$force, requested by ${SUDO_USER:-unknown})"
    mapfile -t devs < <(lspci -D -d 10de: | awk '{print $1}')
    if [ "${#devs[@]}" -eq 0 ]; then
        echo "No NVIDIA PCI device present; nothing to detach."
        jlog "no NVIDIA PCI device present; nothing to detach"
        exit 0
    fi
    jlog "NVIDIA PCI functions: ${devs[*]}"

    for svc in $SERVICES; do
        if systemctl is-active --quiet "$svc"; then
            echo "Stopping $svc"
            jlog "stopping $svc"
            systemctl stop "$svc"
        fi
    done

    holders=$(lsof -t /dev/nvidia* 2>/dev/null | sort -u)
    if [ -n "$holders" ]; then
        echo "Processes still using the GPU:"
        ps -o pid,user,comm -p "$(echo "$holders" | paste -sd,)"
        jlog "processes still using /dev/nvidia* (pid name): $(ps -o pid=,comm= -p "$(echo "$holders" | paste -sd,)" | sed 's/^ *//' | paste -sd';')"
        if [ "$force" -eq 1 ]; then
            echo "Killing them (-f)"
            jlog "killing the holders (-f)"
            kill $holders
            sleep 2
            holders=$(lsof -t /dev/nvidia* 2>/dev/null | sort -u)
            [ -n "$holders" ] && kill -9 $holders && sleep 1
        else
            echo "Close them or rerun with -f. NOT detaching."
            jlog "refusing to detach: the GPU is still in use (rerun with -f)"
            exit 1
        fi
    fi

    for dev in $(printf '%s\n' "${devs[@]}" | sort -r); do
        echo "Removing $dev"
        jlog "removing $dev"
        echo 1 > "/sys/bus/pci/devices/$dev/remove"
    done

    sleep 1
    if lspci -d 10de: | grep -q .; then
        echo "WARNING: NVIDIA device still listed. Do NOT unplug; check dmesg."
        jlog "WARNING: an NVIDIA device is still listed after removal; do not unplug"
        exit 2
    fi
    echo "eGPU detached. Safe to unplug."
    jlog "detached; safe to unplug"
    exit 0
fi

have_gui() { [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; }

notify() {  # notify <urgency> <title> <body>
    have_gui && command -v notify-send >/dev/null && notify-send -u "$1" -i video-display "$2" "$3"
}

# ---- status: waybar JSON ----------------------------------------------------
status() {
    # Cheap checks only (no nvidia-smi), so polling never wakes the GPU.
    if ! lspci -d 10de: | grep -q .; then
        printf '{"text": "", "class": "detached", "tooltip": ""}\n'
    elif [ -d /proc/driver/nvidia/gpus ] && [ -z "$(ls -A /proc/driver/nvidia/gpus 2>/dev/null)" ] \
         && lsmod | grep -q '^nvidia '; then
        # PCI device is listed but the driver has no GPU: the stuck state after a surprise pull.
        printf '{"text": "🎮⚠️", "class": "error", "tooltip": "eGPU in a stuck state. Do not suspend; reboot."}\n'
    else
        name=$(lspci -d 10de: | awk -F': ' '/VGA|3D/ {print $2; exit}' | sed 's/ (rev.*//')
        printf '{"text": "🎮", "class": "attached", "tooltip": "eGPU attached\\n%s\\nClick to detach"}\n' "$name"
    fi
}

# ---- detach: confirmation UI, then privileged part --------------------------
detach() {
    local force=0 yes=0 a
    for a in "$@"; do
        case "$a" in
            -f) force=1 ;;
            -y) yes=1 ;;
        esac
    done

    if ! lspci -d 10de: | grep -q .; then
        echo "No NVIDIA PCI device present; nothing to detach."
        notify low "eGPU" "No eGPU attached."
        return 0
    fi

    local summary="This will stop these services (if running):" svc holders
    for svc in $SERVICES; do
        systemctl is-active --quiet "$svc" && summary+=$'\n  • '"$svc"
    done
    holders=$(lsof /dev/nvidia* 2>/dev/null | awk 'NR>1 {print $1" (pid "$2")"}' | sort -u)
    if [ -n "$holders" ]; then
        if [ "$force" -eq 1 ]; then
            summary+=$'\n\nThese processes will be KILLED:\n'"$(echo "$holders" | sed 's/^/  • /')"
        else
            summary+=$'\n\nStill using the GPU (detach will refuse):\n'"$(echo "$holders" | sed 's/^/  • /')"
        fi
    fi
    summary+=$'\n\nThen the eGPU is removed from the PCI bus.'

    if [ "$yes" -ne 1 ]; then
        if have_gui && command -v zenity >/dev/null; then
            zenity --question --title="Detach eGPU" --width=420 \
                --ok-label="Detach" --cancel-label="Cancel" --text="$summary" || {
                echo "Cancelled."; jlog "detach cancelled by the user"; return 1; }
        else
            printf '%s\n\nProceed? [y/N] ' "$summary"
            read -r ans
            [ "$ans" = "y" ] || { echo "Cancelled."; jlog "detach cancelled by the user"; return 1; }
        fi
    fi

    local out rc pw
    if [ -t 0 ]; then
        out=$(sudo "$(readlink -f "$0")" --root "$force" 2>&1)
        rc=$?
    else
        # Started from waybar: no terminal, so ask for the sudo password graphically.
        pw=$(zenity --password --title="Detach eGPU") || return 1
        out=$(printf '%s\n' "$pw" | sudo -S -p '' "$(readlink -f "$0")" --root "$force" 2>&1)
        rc=$?
        unset pw
    fi
    echo "$out"
    jlog "detach finished with exit code $rc"

    case $rc in
        0) notify normal   "eGPU detached" "Safe to unplug the cable." ;;
        1) notify critical "eGPU NOT detached" "GPU is still in use. Close the apps or run: waybar-egpu detach -f" ;;
        *) notify critical "eGPU detach problem" "Do NOT unplug. Check dmesg." ;;
    esac
    return $rc
}

case "$1" in
    status) status ;;
    detach) shift; detach "$@" ;;
    *) echo "Usage: $0 [status|detach [-f] [-y]]"; exit 1 ;;
esac
