#!/bin/bash
# Manage the eGPU (found by egpu-card): report its state to waybar and disconnect it cleanly.
#   waybar-egpu status          JSON for a waybar custom module
#   waybar-egpu disconnect [-f]  confirm, then disconnect so the cable can be pulled
#       -f  kill processes still using the GPU

# Services to stop before disconnecting.
SERVICES=${WAYBAR_EGPU_SERVICES:-ollama}
NVIDIA=0x10de

# Journal log: journalctl -t waybar-egpu
log() { ${EGPU_LOGGER:-logger} -t waybar-egpu -- "$*" 2>/dev/null || true; }

# NVIDIA is told by PCI vendor, not driver (which may be gone after a surprise unplug).
is_nvidia() { [ "$(cat "/sys/bus/pci/devices/$PCI/vendor" 2>/dev/null)" = "$NVIDIA" ]; }

services() { echo "$SERVICES"; is_nvidia && echo nvidia-persistenced; }

# pids using the eGPU: holders of its DRM nodes (NVIDIA: also /dev/nvidia*).
gpu_users() {
    local n d nodes=()
    if is_nvidia; then
        for n in /dev/nvidia[0-9]* /dev/nvidia-uvm* /dev/nvidia-caps/*; do [ -e "$n" ] && nodes+=("$n"); done
    fi
    for d in /sys/class/drm/card[0-9]/device /sys/class/drm/renderD*/device; do
        [ "$(basename "$(readlink -f "$d")")" = "$PCI" ] || continue
        n=/dev/dri/$(basename "$(dirname "$d")"); [ -e "$n" ] && nodes+=("$n")
    done
    [ "${#nodes[@]}" -gt 0 ] && lsof -t "${nodes[@]}" 2>/dev/null | sort -u
}
# NVIDIA only: pids holding just /dev/nvidiactl. They merely list the GPUs (e.g. Firefox), so
# they do not block.
ctl_only_users() {
    local all
    is_nvidia || return 0
    all=$(gpu_users)
    lsof -t /dev/nvidiactl 2>/dev/null | sort -u | grep -vxFf <(echo "$all")
}

# "pid name;pid name" for the pids in $1, for the log.
pid_names() { ps -o pid=,comm= -p "$(echo "$1" | paste -sd,)" | sed 's/^ *//' | paste -sd';'; }

# ---- privileged part (root, no UI) ------------------------------------------
# sudo's PATH may lack egpu-card, so the eGPU's PCI address ($3) is passed in.
if [ "$1" = "--root" ]; then
    force=$2 PCI=$3
    for dep in lsof systemctl; do
        command -v "$dep" >/dev/null || { echo "waybar-egpu: $dep not found" >&2; exit 1; }
    done
    [[ $PCI =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]] \
        || { echo "waybar-egpu: bad PCI address '$PCI'" >&2; exit 1; }
    log "disconnect start (force=$force, pci=$PCI, requested by ${SUDO_USER:-unknown})"
    devs=()
    for d in /sys/bus/pci/devices/"${PCI%.*}".*; do [ -e "$d" ] && devs+=("${d##*/}"); done
    if [ "${#devs[@]}" -eq 0 ]; then
        log "no eGPU PCI device present; nothing to disconnect"
        exit 0
    fi
    log "eGPU PCI functions: ${devs[*]}"

    for svc in $(services); do
        if systemctl is-active --quiet "$svc"; then
            log "stopping $svc"
            systemctl stop "$svc"
        fi
    done

    ctl=$(ctl_only_users)
    if [ -n "$ctl" ]; then
        log "not blocking, they only have /dev/nvidiactl open (pid name): $(pid_names "$ctl")"
    fi
    holders=$(gpu_users)
    if [ -n "$holders" ]; then
        log "processes still using the GPU (pid name): $(pid_names "$holders")"
        if [ "$force" -eq 1 ]; then
            log "killing the holders (-f)"
            kill $holders
            sleep 2
            holders=$(gpu_users)
            [ -n "$holders" ] && kill -9 $holders && sleep 1
        else
            log "refusing to disconnect: the GPU is still in use (rerun with -f)"
            exit 1
        fi
    fi

    for dev in $(printf '%s\n' "${devs[@]}" | sort -r); do
        log "removing $dev"
        echo 1 > "/sys/bus/pci/devices/$dev/remove"
    done

    sleep 1
    if [ -e "/sys/bus/pci/devices/$PCI" ]; then
        log "WARNING: the eGPU is still listed after removal; do not unplug"
        exit 2
    fi
    log "disconnected; safe to unplug"
    exit 0
fi

for dep in jq lspci lsof egpu-card; do
    command -v "$dep" >/dev/null || { echo "waybar-egpu: $dep not found" >&2; exit 1; }
done
PCI=$(egpu-card --pci)   # empty if no eGPU

notify() {  # notify <urgency> <title> <body>
    notify-send -u "$1" -i video-display "$2" "$3"
}

# ---- status: waybar JSON ------------------------------------------------------
waybar_json() {  # waybar_json <text> <class> <tooltip>
    jq -nc --arg text "$1" --arg class "$2" --arg tooltip "$3" \
        '{text: $text, class: $class, tooltip: $tooltip}'
}

# Driver loaded but no GPU: the stuck state after a surprise unplug.
nvidia_stuck() {
    [ -d /proc/driver/nvidia/gpus ] && [ -z "$(ls -A /proc/driver/nvidia/gpus 2>/dev/null)" ] \
        && lsmod | grep -q '^nvidia '
}

status() {
    # cheap checks only, so polling never wakes the GPU
    if [ -z "$PCI" ]; then
        waybar_json "" disconnected ""
    elif is_nvidia && nvidia_stuck; then
        waybar_json "🎮⚠️" error "eGPU in a stuck state. Do not suspend; reboot."
    else
        name=$(lspci -s "$PCI" | awk -F': ' '{print $2}' | sed 's/ (rev.*//')
        waybar_json "🎮" connected "eGPU connected"$'\n'"$name"$'\n'"Click to disconnect"
    fi
}

# ---- audio: PipeWire can block the removal of the eGPU's audio function ----------------------
# PipeWire keeps /dev/snd/controlC<n> open, which hangs the removal in D state. During the
# privileged step, watch for that and restart PipeWire (it cannot reopen the card by then).
pw_watchdog() {
    local stuck=0 restarted=0
    while sleep 2; do
        if ps -eo stat=,comm= | awk '$1 ~ /^D/ && $2 == "waybar-egpu" {f=1} END {exit !f}'; then
            stuck=$((stuck + 1))
        else
            stuck=0
        fi
        if [ "$stuck" -ge 3 ] && [ "$restarted" -eq 0 ]; then       # stuck for ~6 s
            log "removal is stuck (probably PipeWire holding the audio card); restarting PipeWire"
            systemctl --user restart pipewire pipewire-pulse wireplumber
            restarted=1
        fi
    done
}

# ---- disconnect: confirmation UI, then privileged part --------------------------
disconnect() {
    local force=0
    for dep in zenity notify-send; do
        command -v "$dep" >/dev/null || { echo "waybar-egpu: $dep not found" >&2; return 1; }
    done
    [ "$1" = -f ] && force=1

    if [ -z "$PCI" ]; then
        log "no eGPU present; nothing to disconnect"
        notify low "eGPU" "No eGPU connected."
        return 0
    fi

    local summary="This will stop these services (if running):" svc holders
    for svc in $(services); do
        systemctl is-active --quiet "$svc" && summary+=$'\n  • '"$svc"
    done
    holders=$(gpu_users | while read -r pid; do echo "$(ps -o comm= -p "$pid") (pid $pid)"; done)
    if [ -n "$holders" ]; then
        if [ "$force" -eq 1 ]; then
            summary+=$'\n\nThese processes will be KILLED:\n'"$(echo "$holders" | sed 's/^/  • /')"
        else
            summary+=$'\n\nStill using the GPU (disconnect will refuse):\n'"$(echo "$holders" | sed 's/^/  • /')"
        fi
    fi
    local ctl
    ctl=$(ctl_only_users | while read -r pid; do echo "$(ps -o comm= -p "$pid") (pid $pid)"; done)
    [ -n "$ctl" ] && summary+=$'\n\nOnly list the GPU, not blocking:\n'"$(echo "$ctl" | sed 's/^/  • /')"
    summary+=$'\n\nThen the eGPU is removed from the PCI bus.'

    zenity --question --title="Disconnect eGPU" --width=420 \
        --ok-label="Disconnect" --cancel-label="Cancel" --text="$summary" \
        || { log "disconnect cancelled by the user"; return 1; }

    local out rc pw wd
    if [ -t 0 ]; then
        # our sudo wrapper may use a Yubikey and pass for the password (hence no -S)
        pw_watchdog & wd=$!
        out=$(sudo "$(readlink -f "$0")" --root "$force" "$PCI" 2>&1)
        rc=$?
    else
        pw=$(zenity --password --title="Disconnect eGPU") \
            || { log "disconnect cancelled by the user"; return 1; }
        pw_watchdog & wd=$!
        out=$(printf '%s\n' "$pw" | sudo -S -p '' "$(readlink -f "$0")" --root "$force" "$PCI" 2>&1)
        rc=$?
        unset pw
    fi
    kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
    [ -z "$out" ] || log "output of the privileged part: $out"
    log "disconnect finished with exit code $rc"

    case $rc in
        0) notify normal   "eGPU disconnected" "Safe to unplug the cable." ;;
        1) notify critical "eGPU NOT disconnected" "GPU is still in use. Close the apps or run: waybar-egpu disconnect -f" ;;
        *) notify critical "eGPU disconnect problem" "Do NOT unplug. Check dmesg." ;;
    esac
    return $rc
}

case "$1" in
    status) status ;;
    disconnect) shift; disconnect "$@" ;;
    *) echo "Usage: $0 [status|disconnect [-f]]"; exit 1 ;;
esac
