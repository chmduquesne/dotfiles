#!/bin/bash
# Manage the Thunderbolt eGPU (NVIDIA): report its state to waybar and disconnect it cleanly.
#   waybar-egpu status          JSON for a waybar custom module
#   waybar-egpu disconnect [-f] [-y]  confirm, then cleanly disconnect so the cable can be pulled
#       -f  kill processes still using the GPU
#       -y  skip the confirmation dialog

SERVICES="ollama nvidia-persistenced"

# Journal logging, for post-mortems: journalctl -t waybar-egpu. Never fails the script.
jlog() { logger -t waybar-egpu -- "$*" 2>/dev/null || true; }

# Who really uses the eGPU: processes holding its device nodes (/dev/nvidia0.., nvidia-uvm,
# nvidia-caps, and the DRM nodes of the NVIDIA card, e.g. a game session on its display).
# Holding only /dev/nvidiactl is NOT counted: that is what any program does that merely lists the
# GPUs (e.g. Firefox's media process via EGL) without using one.
gpu_users() {
    local n d nodes=()
    for n in /dev/nvidia[0-9]* /dev/nvidia-uvm* /dev/nvidia-caps/*; do [ -e "$n" ] && nodes+=("$n"); done
    for d in /sys/class/drm/card[0-9]/device /sys/class/drm/renderD*/device; do
        [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
        n=/dev/dri/$(basename "$(dirname "$d")"); [ -e "$n" ] && nodes+=("$n")
    done
    [ "${#nodes[@]}" -gt 0 ] && lsof -t "${nodes[@]}" 2>/dev/null | sort -u
}
# Holders of /dev/nvidiactl only (not blocking); pids on stdout.
ctl_only_users() {
    local all
    all=$(gpu_users)
    lsof -t /dev/nvidiactl 2>/dev/null | sort -u | grep -vxFf <(echo "$all") 
}

# ---- privileged part (runs as root, no UI) ---------------------------------
if [ "$1" = "--root" ]; then
    force=$2
    jlog "disconnect start (force=$force, requested by ${SUDO_USER:-unknown})"
    mapfile -t devs < <(lspci -D -d 10de: | awk '{print $1}')
    if [ "${#devs[@]}" -eq 0 ]; then
        echo "No NVIDIA PCI device present; nothing to disconnect."
        jlog "no NVIDIA PCI device present; nothing to disconnect"
        exit 0
    fi
    jlog "NVIDIA PCI functions: ${devs[*]}"

    for svc in $SERVICES; do
        if systemctl is-active --quiet "$svc"; then
            echo "Stopping $svc"
            jlog "stopping $svc"
            systemctl stop "$svc"
        fi
    done

    ctl=$(ctl_only_users)
    if [ -n "$ctl" ]; then
        jlog "not blocking, they only have /dev/nvidiactl open (pid name): $(ps -o pid=,comm= -p "$(echo "$ctl" | paste -sd,)" | sed 's/^ *//' | paste -sd';')"
    fi
    holders=$(gpu_users)
    if [ -n "$holders" ]; then
        echo "Processes still using the GPU:"
        ps -o pid,user,comm -p "$(echo "$holders" | paste -sd,)"
        jlog "processes still using the GPU (pid name): $(ps -o pid=,comm= -p "$(echo "$holders" | paste -sd,)" | sed 's/^ *//' | paste -sd';')"
        if [ "$force" -eq 1 ]; then
            echo "Killing them (-f)"
            jlog "killing the holders (-f)"
            kill $holders
            sleep 2
            holders=$(gpu_users)
            [ -n "$holders" ] && kill -9 $holders && sleep 1
        else
            echo "Close them or rerun with -f. NOT disconnecting."
            jlog "refusing to disconnect: the GPU is still in use (rerun with -f)"
            exit 1
        fi
    fi

    for dev in $(printf '%s\n' "${devs[@]}" | sort -r); do
        echo "Removing $dev"
        jlog "removing $dev"
        echo 1 > "/sys/bus/pci/devices/$dev/remove"
    done

    sleep 1
    if lspci -d 10de: | grep -q .; then
        echo "WARNING: NVIDIA device still listed. Do NOT unplug; check dmesg."
        jlog "WARNING: an NVIDIA device is still listed after removal; do not unplug"
        exit 2
    fi
    echo "eGPU disconnected. Safe to unplug."
    jlog "disconnected; safe to unplug"
    exit 0
fi

have_gui() { [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; }

notify() {  # notify <urgency> <title> <body>
    have_gui && command -v notify-send >/dev/null && notify-send -u "$1" -i video-display "$2" "$3"
}

# ---- status: waybar JSON ----------------------------------------------------
status() {
    # Cheap checks only (no nvidia-smi), so polling never wakes the GPU.
    if ! lspci -d 10de: | grep -q .; then
        printf '{"text": "", "class": "disconnected", "tooltip": ""}\n'
    elif [ -d /proc/driver/nvidia/gpus ] && [ -z "$(ls -A /proc/driver/nvidia/gpus 2>/dev/null)" ] \
         && lsmod | grep -q '^nvidia '; then
        # PCI device is listed but the driver has no GPU: the stuck state after a surprise pull.
        printf '{"text": "🎮⚠️", "class": "error", "tooltip": "eGPU in a stuck state. Do not suspend; reboot."}\n'
    else
        name=$(lspci -d 10de: | awk -F': ' '/VGA|3D/ {print $2; exit}' | sed 's/ (rev.*//')
        printf '{"text": "🎮", "class": "connected", "tooltip": "eGPU connected\\n%s\\nClick to disconnect"}\n' "$name"
    fi
}

# ---- audio: PipeWire can block the removal of the eGPU's HDMI audio function ----------------
# PipeWire keeps /dev/snd/controlC<n> of the card open and does not close it when the card goes
# away (setting the card profile to "off" does not release it either: tried 2026-10-09). The
# kernel's removal (snd_card_free) then waits forever, in uninterruptible sleep. Restarting
# PipeWire closes the handle and the removal finishes. So: while the privileged step runs, watch
# for it being stuck in D state, and restart PipeWire (once the removal has begun, PipeWire
# cannot reopen the card).
pw_watchdog() {
    local stuck=0 restarted=0
    while sleep 2; do
        if ps -eo stat=,comm= | awk '$1 ~ /^D/ && $2 == "waybar-egpu" {f=1} END {exit !f}'; then
            stuck=$((stuck + 1))
        else
            stuck=0
        fi
        if [ "$stuck" -ge 3 ] && [ "$restarted" -eq 0 ]; then       # stuck for ~6 s
            jlog "removal is stuck (probably PipeWire holding the audio card); restarting PipeWire"
            systemctl --user restart pipewire pipewire-pulse wireplumber
            restarted=1
        fi
    done
}

# ---- disconnect: confirmation UI, then privileged part --------------------------
disconnect() {
    local force=0 yes=0 a
    for a in "$@"; do
        case "$a" in
            -f) force=1 ;;
            -y) yes=1 ;;
        esac
    done

    if ! lspci -d 10de: | grep -q .; then
        echo "No NVIDIA PCI device present; nothing to disconnect."
        notify low "eGPU" "No eGPU connected."
        return 0
    fi

    local summary="This will stop these services (if running):" svc holders
    for svc in $SERVICES; do
        systemctl is-active --quiet "$svc" && summary+=$'\n  • '"$svc"
    done
    holders=$(gpu_users | while read -r pid; do echo "$(ps -o comm= -p "$pid") (pid $pid)"; done)
    if [ -n "$holders" ]; then
        if [ "$force" -eq 1 ]; then
            summary+=$'\n\nThese processes will be KILLED:\n'"$(echo "$holders" | sed 's/^/  • /')"
        else
            summary+=$'\n\nStill using the GPU (disconnect will refuse):\n'"$(echo "$holders" | sed 's/^/  • /')"
        fi
    fi
    local ctl
    ctl=$(ctl_only_users | while read -r pid; do echo "$(ps -o comm= -p "$pid") (pid $pid)"; done)
    [ -n "$ctl" ] && summary+=$'\n\nOnly list the GPU, not blocking:\n'"$(echo "$ctl" | sed 's/^/  • /')"
    summary+=$'\n\nThen the eGPU is removed from the PCI bus.'

    if [ "$yes" -ne 1 ]; then
        if have_gui && command -v zenity >/dev/null; then
            zenity --question --title="Disconnect eGPU" --width=420 \
                --ok-label="Disconnect" --cancel-label="Cancel" --text="$summary" || {
                echo "Cancelled."; jlog "disconnect cancelled by the user"; return 1; }
        else
            printf '%s\n\nProceed? [y/N] ' "$summary"
            read -r ans
            [ "$ans" = "y" ] || { echo "Cancelled."; jlog "disconnect cancelled by the user"; return 1; }
        fi
    fi

    local out rc pw wd
    if [ -t 0 ]; then
        pw_watchdog & wd=$!
        out=$(sudo "$(readlink -f "$0")" --root "$force" 2>&1)
        rc=$?
    else
        # Started from waybar: no terminal, so ask for the sudo password graphically.
        pw=$(zenity --password --title="Disconnect eGPU") || return 1
        pw_watchdog & wd=$!
        out=$(printf '%s\n' "$pw" | sudo -S -p '' "$(readlink -f "$0")" --root "$force" 2>&1)
        rc=$?
        unset pw
    fi
    kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
    echo "$out"
    jlog "disconnect finished with exit code $rc"

    case $rc in
        0) notify normal   "eGPU disconnected" "Safe to unplug the cable." ;;
        1) notify critical "eGPU NOT disconnected" "GPU is still in use. Close the apps or run: waybar-egpu disconnect -f" ;;
        *) notify critical "eGPU disconnect problem" "Do NOT unplug. Check dmesg." ;;
    esac
    return $rc
}

case "$1" in
    status) status ;;
    disconnect) shift; disconnect "$@" ;;
    *) echo "Usage: $0 [status|disconnect [-f] [-y]]"; exit 1 ;;
esac
