#!/bin/bash

# Block idle (screen lock, suspend) while audio is playing or recording.
# Polls audiostatus and holds a systemd idle inhibitor while it reports busy.

readonly POLL_INTERVAL=5

holder=""

acquire(){
    systemd-inhibit --what=idle --who="${0##*/}" --why="Audio active" sleep infinity &
    holder=$!
}

release(){
    [[ -n "$holder" ]] && kill "$holder" 2>/dev/null
    holder=""
}

main(){
    trap release EXIT
    trap 'exit' INT TERM

    while true; do
        if audiostatus --quiet; then
            [[ -z "$holder" ]] && acquire
        else
            release
        fi

        sleep "$POLL_INTERVAL"
    done
}

main
