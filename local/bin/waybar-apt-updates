#!/bin/bash
# waybar-apt-updates: pending apt updates for waybar, as JSON.
#
# The count comes from simulating a dist-upgrade against the local package lists, which only
# change on `apt update`. The lists' age is read from a stamp file.
#
# Setup: have apt refresh the lists daily and stamp each successful refresh. Put this in
# /etc/apt/apt.conf.d/20update-package-lists:
#   APT::Periodic::Update-Package-Lists "1";
#   APT::Update::Post-Invoke-Success { "touch /var/lib/apt/periodic/update-success-stamp"; };
# The first line makes apt-daily.timer run `apt update` once a day (without it the timer does
# nothing); the second writes the stamp. Without the stamp, the tooltip has no age line.

STAMP=/var/lib/apt/periodic/update-success-stamp
MAX_NAMES=15

emit() {
    jq -nc --arg text "$1" --arg class "$2" --arg tooltip "$3" \
        '{text: $text, class: $class, alt: $class, tooltip: $tooltip}'
}

# "3 hours ago" for the age of $STAMP; prints nothing if there is no stamp.
lists_age() {
    local secs
    [ -e "$STAMP" ] || return 0
    secs=$(( $(date +%s) - $(stat -c %Y "$STAMP") ))
    if   [ "$secs" -ge 86400 ]; then echo "$((secs / 86400)) days ago"
    elif [ "$secs" -ge 3600 ];  then echo "$((secs / 3600)) hours ago"
    else echo "$((secs / 60)) minutes ago"
    fi
}

plan=$(apt-get -q -s dist-upgrade 2>&1) || { emit "?" error "apt-get failed: ${plan##*$'\n'}"; exit 0; }

names=$(awk '/^Inst/ {print $2}' <<< "$plan")
count=$(awk '/^Inst/ {n++} END {print n + 0}' <<< "$plan")

if [ "$count" -eq 0 ]; then
    class=updated
    tooltip="All packages are up to date"
else
    class=has-updates
    tooltip="$count updates available"$'\n\n'$(head -n "$MAX_NAMES" <<< "$names")
    [ "$count" -gt "$MAX_NAMES" ] && tooltip+=$'\n'"... and $((count - MAX_NAMES)) more"
fi

age=$(lists_age)
[ -n "$age" ] && tooltip+=$'\n\n'"Lists refreshed $age"

emit "$count" "$class" "$tooltip"
