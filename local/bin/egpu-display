#!/bin/bash
# egpu-display: the long-running host that owns the eGPU's display, on tty2.
#   egpu-display   runs forever; started by egpu-display.service (or by hand in a tty2 login)
#
# It waits for requests from `egpu-launch`, runs `egpu-kiosk` in its own tty session (which
# logind lets take the eGPU's display), then switches back to the desktop session. It reads no
# keyboard input.
#
# Protocol (in $XDG_RUNTIME_DIR):
#   egpu-display.fifo      requests: <desktop session>TAB<reply fifo>TAB<quoted command>
#   egpu-display.session   "<pid> <session id>" of this host (egpu-launch needs both)
#   egpu-display.lock      single-instance lock
# The reply fifo gets the exit code of egpu-kiosk.
#
# Testing hooks: EGPU_RUNTIME (instead of $XDG_RUNTIME_DIR), EGPU_KIOSK (runner), EGPU_LOGINCTL
# (instead of loginctl), EGPU_LOGGER.
# Log: journalctl -t egpu-display -t egpu-kiosk (add -k for the kernel log)

# A service started with PAMName= can carry CAP_WAKE_ALARM, which makes Steam's sandbox
# (bubblewrap) refuse to run. Clear the capabilities and re-exec once.
# (EGPU_STATUS: testing hook, a status file instead of /proc/self/status.)
if [ -z "$EGPU_CAPS_DROPPED" ] && command -v setpriv >/dev/null \
   && grep -Eq '^Cap(Prm|Eff|Amb):[[:space:]]*0*[1-9a-fA-F]' "${EGPU_STATUS:-/proc/self/status}"; then
    export EGPU_CAPS_DROPPED=1
    exec setpriv --ambient-caps=-all --inh-caps=-all "$0" "$@"
fi

RT=${EGPU_RUNTIME:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}
KIOSK=${EGPU_KIOSK:-$HOME/.local/bin/egpu-kiosk}
LOGINCTL=${EGPU_LOGINCTL:-loginctl}
FIFO=$RT/egpu-display.fifo
SESSFILE=$RT/egpu-display.session
LOCKFILE=$RT/egpu-display.lock

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/games:$PATH"

for dep in ${LOGINCTL%% *} jq flock "$KIOSK"; do
    command -v "$dep" >/dev/null || { echo "egpu-display: $dep not found" >&2; exit 1; }
done

log() { ${EGPU_LOGGER:-logger} -t egpu-display -- "$*" 2>/dev/null || true; }

# Nothing may read this tty's keyboard. As a service (INVOCATION_ID is set) the tty is also
# made inert (no echo, Ctrl+C etc. are plain characters) so nobody can kill the host by
# keyboard; by hand, signals stay on.
if [ -n "$INVOCATION_ID" ] && [ -t 0 ]; then stty -isig -echo 2>/dev/null; fi
exec </dev/null

# Only one host at a time.
exec 9>"$LOCKFILE" || { echo "egpu-display: cannot create $LOCKFILE" >&2; exit 1; }
flock -n 9 || { echo "egpu-display: already running." >&2; exit 1; }

# This host's own logind session: the one on tty2 (XDG_SESSION_ID when we run in it).
my_session() {
    if [ -n "$XDG_SESSION_ID" ]; then echo "$XDG_SESSION_ID"; return 0; fi
    $LOGINCTL list-sessions --json=short 2>/dev/null \
        | jq -r 'first(.[] | select(.tty == "tty2") | .session) // empty'
}
ME=$(my_session)
[ -n "$ME" ] || { echo "egpu-display: cannot find my own logind session." >&2; exit 1; }

# Poll until our session is the active one (the screen has really switched to this VT).
wait_active() {
    local i
    for i in $(seq 1 20); do
        [ "$($LOGINCTL show-session "$ME" -p Active --value 2>/dev/null)" = yes ] && return 0
        sleep 0.5
    done
    return 1
}

cleanup() { rm -f "$FIFO" "$SESSFILE"; log "host stopped"; }
trap cleanup EXIT
trap 'exit 0' TERM INT

[ -p "$FIFO" ] || { rm -f "$FIFO"; mkfifo -m 600 "$FIFO"; }
exec 3<>"$FIFO"           # read-write: never sees EOF between requests
echo "$$ $ME" > "$SESSFILE"
log "host started: pid=$$ session=$ME"

while IFS=$'\t' read -r desk done cmdstr <&3; do
    [ -n "$desk" ] && [ -n "$done" ] || continue
    log "request: desktop=$desk reply=$done cmd=$cmdstr"
    wait_active || log "warning: session $ME not active after 10 s; continuing anyway"

    eval "set -- $cmdstr"        # the line was quoted with printf %q by egpu-launch
    "$KIOSK" "$@"
    rc=$?
    log "kiosk exited rc=$rc"

    "$LOGINCTL" activate "$desk" \
        || log "warning: could not switch back to session $desk"

    # Reply without ever blocking: opening a fifo read-write does not wait for a reader.
    { exec 5<>"$done" && echo "$rc" >&5; exec 5>&-; } 2>/dev/null
done
