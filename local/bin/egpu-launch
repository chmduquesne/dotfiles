#!/bin/bash
# egpu-launch: from the desktop, show a program on the eGPU's display.
#   egpu-launch command [args...]        e.g.  egpu-launch steam
#
# It asks egpu-launchd (on tty2) to run the program with egpu-kiosk, switches your screen to
# that session and waits; the daemon switches back when the program is done. No sudo. The exit
# code is the kiosk's. If you leave with Ctrl+Alt+F1 the program keeps running, and a second
# egpu-launch is refused until it ends.

RT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
FIFO=$RT/egpu-launchd.fifo
SESSFILE=$RT/egpu-launchd.session
LOCKFILE=$RT/egpu-launch.lock

die() { echo "egpu-launch: $*" >&2; exit 1; }

[ $# -gt 0 ] && [ -n "$1" ] \
    || { echo "usage: egpu-launch command [args...]   (e.g. egpu-launch steam)" >&2; exit 2; }

# The graphical session (wayland or x11) of this seat.
desktop_session() {
    local s
    for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
        case "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" in
            wayland|x11) echo "$s"; return 0 ;;
        esac
    done
    return 1
}

for dep in loginctl flock egpu-card; do
    command -v "$dep" >/dev/null || { echo "egpu-launch: $dep not found" >&2; exit 1; }
done

desk=$(desktop_session) || die "no graphical session found."
egpu-card >/dev/null || die "the eGPU is not connected."

[ -p "$FIFO" ] && [ -r "$SESSFILE" ] \
    || die "the launch daemon is not running (egpu-launchd.service, or egpu-launchd in a tty2 login)."
read -r hostpid hostsess < "$SESSFILE"
kill -0 "$hostpid" 2>/dev/null || die "the launch daemon is not running (stale session file)."

exec 8>"$LOCKFILE"
flock -n 8 || die "a program is already running on the eGPU display."

reply=$(mktemp -u "$RT/egpu-launch.reply.XXXXXX")
mkfifo -m 600 "$reply" || die "cannot create the reply fifo."
exec 4<>"$reply"
trap 'rm -f "$reply"' EXIT

# Switch the screen first, so a failure here queues nothing.
loginctl activate "$hostsess" || die "cannot switch to session $hostsess."

exec 6<>"$FIFO"
printf '%s\t%s\t%s\n' "$desk" "$reply" "$(printf '%q ' "$@")" >&6
exec 6>&-

# Wait for the program to finish; give up if the daemon dies meanwhile.
while ! read -r -t 5 -u 4 rc; do
    kill -0 "$hostpid" 2>/dev/null || die "the launch daemon died."
done
if [ "${rc:-1}" != 0 ]; then
    echo "egpu-launch: the program ended with code ${rc:-1}; see: journalctl -t egpu-kiosk -t egpu-launchd -b" >&2
fi
exit "${rc:-1}"
