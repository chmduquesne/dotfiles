#!/bin/bash
# claude-sandboxed [--notrust] [ARGS]: run Claude Code in a rootless podman container, with the current
# directory mounted at /src.
#
# Claude Code uses the host settings, skills and plugins (read-only), but not your host
# history or memory. It authenticates with a long-lived token, not your main login: create one
# with `claude setup-token` and save it in ~/.claude-sandboxed-token (or set
# CLAUDE_SANDBOXED_TOKEN_FILE).
# Sessions and memory are kept in .claude-sandbox in the project, for `--continue` and `--resume`
# (the directory ignores itself in git). Everything else Claude writes is lost on exit.
# --notrust, for code you do not trust, keeps nothing: no .claude-sandbox directory, so no
# memory or transcripts that a prompt injection could survive in or leak. Other ARGS go to claude.
#
# Protected: no capabilities, non-root, read-only root filesystem (writable: /src, /tmp and a
# throwaway $HOME), pid and memory limits, no SSH agent, .git read-only.
# NOT protected: the network is open (the agent can send out anything it can read, including that token), and /src
# is writable, so whatever the agent writes there can run later on the host. Before running
# anything it touched on the host, check `git diff` and .envrc, Makefile, package scripts,
# editor tasks. Commit and push from the host: .git is read-only inside.

AGENT=claude

dockerfile(){
	local version
	version="$(claude --version 2>/dev/null | cut -d' ' -f1)"

	cat <<-EOF
	FROM ubuntu:22.04

	RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \\
		git \\
		python3 \\
		python3-pip \\
		curl \\
		ca-certificates \\
		vim

	# Claude Code, pinned to the version used on the host, installed where any user can run it
	RUN curl -fsSL https://claude.ai/install.sh | HOME=/opt/claude bash -s $version \\
		&& ln -s /opt/claude/.local/bin/claude /usr/local/bin/claude \\
		&& chmod -R a+rX /opt/claude

	WORKDIR /src
	# The home directory is an empty tmpfs. Skip the onboarding and trust prompts by seeding
	# ~/.claude.json, and link the read-only host config into a writable ~/.claude (mounting it
	# there directly would leave ~/.claude owned by root, and Claude could not write its state)
	ENTRYPOINT ["sh", "-c", "mkdir -p \"\$HOME/.claude\" && echo '{\"hasCompletedOnboarding\":true,\"theme\":\"dark\",\"projects\":{\"/src\":{\"hasTrustDialogAccepted\":true}}}' > \"\$HOME/.claude.json\" && for f in /host-claude/*; do [ -e \"\$f\" ] && ln -s \"\$f\" \"\$HOME/.claude/\"; done; if [ -n \"\$SANDBOX_PERSIST\" ]; then [ -e /src/.claude-sandbox/.gitignore ] || echo '*' > /src/.claude-sandbox/.gitignore; ln -s /src/.claude-sandbox \"\$HOME/.claude/projects\"; fi; exec claude \"\$@\"", "claude"]
	EOF
}

run(){
	local project mounts=(-v "$PWD:/src") ctx rc settings notrust
	project="$(basename "$PWD")"

	# .git is a file in worktrees and submodules: only a directory can be remounted read-only
	[[ -d .git ]] && mounts+=(-v "$PWD/.git:/src/.git:ro")

	local token_file="${CLAUDE_SANDBOXED_TOKEN_FILE:-$HOME/.claude-sandboxed-token}" path
	[[ -r $token_file ]] || { echo "No token in $token_file: run claude setup-token and save it there" >&2; exit 1; }
	# passed through the environment, so that it does not show up in the command line
	export CLAUDE_CODE_OAUTH_TOKEN
	CLAUDE_CODE_OAUTH_TOKEN="$(<"$token_file")"

	# --notrust is ours, not Claude's: nothing is kept. Otherwise sessions and memory are kept in
	# the project (the container links ~/.claude/projects to it)
	local args=() arg
	for arg in "$@"; do
		if [[ $arg == --notrust ]]; then notrust=1; else args+=("$arg"); fi
	done
	if [[ -z $notrust ]]; then
		mkdir -p .claude-sandbox || exit 1
		mounts+=(-e SANDBOX_PERSIST=1)
	fi

	# the host settings, minus what cannot work in the container (remote control, push notifications)
	if [[ -e ~/.claude/settings.json ]]; then
		settings="$(mktemp)"
		trap 'rm -f "$settings"' EXIT
		jq 'del(.remoteControlAtStartup, .agentPushNotifEnabled)' ~/.claude/settings.json > "$settings" || exit 1
		mounts+=(-v "$settings:/host-claude/settings.json:ro")
	fi

	for path in CLAUDE.md skills plugins; do
		[[ -e ~/.claude/$path ]] && mounts+=(-v "$HOME/.claude/$path:/host-claude/$path:ro")
	done

	# the Dockerfile needs no files from the project: build it with an empty context. Cached
	# layers make this fast when the Dockerfile has not changed
	ctx="$(mktemp -d)"
	dockerfile | podman build -q -t "$AGENT-sandbox" -f - "$ctx" >/dev/null
	rc=$?
	rmdir "$ctx"
	[[ $rc -eq 0 ]] || exit 1

	# $HOME is an empty tmpfs at the host path, so that absolute paths in the agent's config
	# keep working. Everything the agent writes there is lost on exit
	podman run -it \
		--rm \
		--cap-drop=all \
		--security-opt no-new-privileges \
		--userns=keep-id \
		--pids-limit=1024 \
		--memory=12g \
		--read-only \
		--tmpfs /tmp \
		--tmpfs "$HOME" \
		-e HOME="$HOME" \
		-e DISABLE_AUTOUPDATER=1 \
		-e CLAUDE_CODE_OAUTH_TOKEN \
		"${mounts[@]}" \
		--name "$project-$AGENT" \
		"$AGENT-sandbox" \
		"${args[@]}"
}

run "$@"
