#!/bin/bash
# egpu-kiosk: run ONE program fullscreen on the eGPU's display, inside a sway kiosk.
#   egpu-kiosk command [args...]        e.g.  egpu-kiosk steam
#
# The kiosk must run in a tty session of its own (a free VT, or egpu-launchd on tty2), not in the
# desktop session: logind only gives the display to the active session. From the desktop,
# use `egpu-launch`.
#
# In order:
#   1. unloads ollama models (frees the VRAM)
#   2. switches the LG monitor to the eGPU's input (lgmonitor-input) and, if the audio was on
#      the monitor, moves it along (egpu-audio); on failure it exits 1 rather than run on a
#      screen nobody can see
#   3. runs sway on the eGPU only (config: ~/.config/egpu/kiosk-sway.conf) with the program
#   4. on exit: stops every process left over from the program (sway runs in a systemd scope,
#      so e.g. Steam's tray process goes too), switches the monitor back to USB-C, restores audio
#
# Alt+Esc quits the kiosk.
# Log: journalctl -t egpu-kiosk (add -k for the kernel log); sway output (noisy):
#      ${XDG_STATE_HOME:-~/.local/state}/sway-egpu-kiosk.log

# A service started with PAMName= can carry CAP_WAKE_ALARM, which makes Steam's sandbox
# (bubblewrap) refuse to run. Clear the capabilities and re-exec once.
if [ -z "$EGPU_CAPS_DROPPED" ] \
   && grep -Eq '^Cap(Prm|Eff|Amb):[[:space:]]*0*[1-9a-fA-F]' /proc/self/status; then
    if command -v setpriv >/dev/null; then
        export EGPU_CAPS_DROPPED=1
        exec setpriv --ambient-caps=-all --inh-caps=-all "$0" "$@"
    fi
    echo "egpu-kiosk: warning: setpriv not found; Steam's sandbox may refuse to run." >&2
fi

STATE=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$STATE"
SWAYLOG=$STATE/sway-egpu-kiosk.log
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/egpu/kiosk-sway.conf

# Minimal environments (systemd service) lack these.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/games:$PATH"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

log() { logger -t egpu-kiosk -- "$*" 2>/dev/null || true; }

if [ $# -eq 0 ] || [ -z "$1" ]; then
    echo "usage: egpu-kiosk command [args...]   (e.g. egpu-kiosk steam)" >&2
    exit 2
fi
cmd=("$@")

for dep in sway systemd-run egpu-card egpu-audio lgmonitor-input; do
    command -v "$dep" >/dev/null || { echo "egpu-kiosk: $dep not found" >&2; exit 1; }
done

card=$(egpu-card) || { echo "egpu-kiosk: the eGPU is not connected." >&2; exit 1; }
[ -r "$CONF" ] || { echo "egpu-kiosk: missing config $CONF" >&2; exit 1; }

log "start: user=$(id -un) session=${XDG_SESSION_ID:-?} vt=${XDG_VTNR:-?} cmd=${cmd[*]}"

# --- 1. free the VRAM (best effort; the ollama service itself keeps running) -------------
if command -v ollama >/dev/null; then
    command -v curl >/dev/null && command -v jq >/dev/null \
        || log "ollama: curl or jq missing; models not unloaded"
    host=${OLLAMA_HOST:-127.0.0.1:11434}; host=${host#http://}
    loaded=$(curl -s -m 10 "http://$host/api/ps" 2>/dev/null | jq -r '.models[].name' 2>/dev/null)
    for m in $loaded; do
        timeout 20 ollama stop "$m" >/dev/null 2>&1 && log "ollama: unloaded $m"
    done
fi

# --- cleanup, however we end (step 4 above; defined early so the trap covers every exit) ---
# Some programs (Steam) outlive their window and would block `egpu-disconnect`. Sway
# runs in a transient scope: stopping it terminates everything the program left behind.
SCOPE=egpu-kiosk-app.scope
# restore_monitor is set before the monitor switch, so a failed switch still tries to switch back.
restore_monitor=
cleanup() {
    systemctl --user stop "$SCOPE" >/dev/null 2>&1
    if [ -n "$restore_monitor" ]; then
        egpu-audio unfollow -- lgmonitor-input set usbc \
            || echo "egpu-kiosk: could not switch the monitor back; use its input button." >&2
    fi
    log "cleanup done"
}
trap cleanup EXIT

# A scope left by a run that was killed hard would make systemd-run fail on the name below.
if systemctl --user is-active --quiet "$SCOPE"; then
    log "stopping a stale $SCOPE"
    systemctl --user stop "$SCOPE" >/dev/null 2>&1
fi

# --- 2. monitor input (LG, over DDC/CI: see lgmonitor-input) and audio ---------------------
# The input is whichever one the monitor reaches the eGPU through (the cable can move). A
# failure here ends the run: the kiosk would show a black screen nobody can leave.
fail() { echo "egpu-kiosk: $*" >&2; log "abort: $*"; exit 1; }

input=
for _ in 1 2 3; do   # the DDC scan sometimes misses the eGPU's link once
    input=$(lgmonitor-input find "$card" 2>/dev/null) && [ -n "$input" ] && break
    input=; sleep 2
done
[ -n "$input" ] || fail "no monitor input is wired to the eGPU ($card)."
restore_monitor=1
log "monitor input for the eGPU: $input"
egpu-audio follow -- lgmonitor-input set "$input" \
    || fail "could not switch the monitor to $input."

# --- 3. the kiosk -----------------------------------------------------------------------
# The sway config runs KIOSK_CMD and then exits sway, whose own exit code is always 0. So the
# program's exit code is written to a file, and becomes ours. If the file is missing (Alt+Esc,
# or sway died) we keep sway's code.
: > "$SWAYLOG"
rcfile=$XDG_RUNTIME_DIR/egpu-kiosk.rc
rm -f "$rcfile"
KIOSK_CMD="$(printf '%q ' "${cmd[@]}"); echo \$? > $(printf '%q' "$rcfile")" \
WLR_DRM_DEVICES=/dev/dri/$card \
WLR_NO_HARDWARE_CURSORS=1 \
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
__GLX_VENDOR_LIBRARY_NAME=nvidia \
systemd-run --user --scope --collect --quiet --unit="${SCOPE%.scope}" -p TimeoutStopSec=20 \
    sway --unsupported-gpu -c "$CONF" >> "$SWAYLOG" 2>&1
rc=$?
log "sway exited rc=$rc"
if [ -r "$rcfile" ] && read -r prog_rc < "$rcfile" && [[ $prog_rc =~ ^[0-9]+$ ]]; then
    log "program exited rc=$prog_rc"
    rc=$prog_rc
fi
rm -f "$rcfile"
exit $rc
