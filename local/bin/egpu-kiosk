#!/bin/bash
# egpu-kiosk: run ONE program fullscreen on the eGPU's HDMI output, inside a sway kiosk.
#   egpu-kiosk command [args...]        e.g.  egpu-kiosk steam
#
# This is the runner. It must run in a plain tty session (a login on a free VT, or the
# egpu-display service on tty2), NOT inside tmux and not in your desktop session: logind
# only gives the display to the active session. From the desktop, use `egpu-launch`.
#
# What it does, in order:
#   1. unloads ollama models (frees the 24 GB of VRAM for the program)
#   2. switches the LG monitor to the input the eGPU (card1) is plugged into, over DDC/CI
#      (lgmonitor-input)
#      and, if the audio was on the monitor, moves it to the eGPU's HDMI audio (egpu-audio)
#   3. runs sway on the eGPU only (config: ~/.config/egpu/kiosk-sway.conf) with the program
#   4. on any exit: shuts Steam down, switches the monitor back to USB-C, restores audio
#
# The monitor input switching, with all its LG quirks, lives in `lgmonitor-input`.
#
# Alt+Esc quits the kiosk.
# Logs: journalctl -t egpu-kiosk   (events, ordered with the kernel log: add -k)
#       ${XDG_STATE_HOME:-~/.local/state}/sway-egpu-kiosk.log   (sway/Xwayland output, noisy)
#
# Environment knobs:  EGPU_DRYRUN=1  only print what would run (testing)
#                     EGPU_LOGGER=cmd  use cmd instead of logger (testing)
#                     EGPU_BINDIR=dir  directory searched first for commands (testing)

# A service started with PAMName= can carry a real (ambient) capability, CAP_WAKE_ALARM. Steam's
# sandbox (bubblewrap) then refuses to run ("Unexpected capabilities but not setuid"), which
# Steam reports as "Steam now requires user namespaces". Clear them and re-exec once.
# (EGPU_STATUS is a testing hook: the status file to inspect instead of /proc/self/status.)
if [ -z "$EGPU_CAPS_DROPPED" ] && command -v setpriv >/dev/null \
   && grep -Eq '^Cap(Prm|Eff|Amb):[[:space:]]*0*[1-9a-fA-F]' "${EGPU_STATUS:-/proc/self/status}"; then
    export EGPU_CAPS_DROPPED=1
    exec setpriv --ambient-caps=-all --inh-caps=-all "$0" "$@"
fi

STATE=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$STATE"
SWAYLOG=$STATE/sway-egpu-kiosk.log
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/egpu/kiosk-sway.conf

# Minimal environments (systemd service) lack these.
export PATH="${EGPU_BINDIR:+$EGPU_BINDIR:}$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/games:$PATH"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

log() { ${EGPU_LOGGER:-logger} -t egpu-kiosk -- "$*" 2>/dev/null || true; }

# The command is always explicit: no default, and an empty command is refused.
if [ $# -eq 0 ] || [ -z "$1" ]; then
    echo "usage: egpu-kiosk command [args...]   (e.g. egpu-kiosk steam)" >&2
    exit 2
fi
cmd=("$@")
[ "${cmd[0]}" = steam ] && cmd[0]=/usr/games/steam

if [ -n "$EGPU_DRYRUN" ]; then
    printf 'would run in the sway kiosk: %s\n' "$(printf '%q ' "${cmd[@]}")"
    exit 0
fi

# Inside tmux the shell belongs to the desktop login session, which is inactive on
# another VT, so logind would refuse sway the display (black screen).
if [ -n "$TMUX" ]; then
    echo "egpu-kiosk: refusing to run inside tmux (it inherits the desktop session)." >&2
    exit 1
fi
lspci -d 10de: | grep -q . || { echo "egpu-kiosk: the eGPU is not connected." >&2; exit 1; }
[ -r "$CONF" ] || { echo "egpu-kiosk: missing config $CONF" >&2; exit 1; }

log "start: user=$(id -un) session=${XDG_SESSION_ID:-?} vt=${XDG_VTNR:-?} cmd=${cmd[*]}"

# --- 1. free the VRAM (best effort; the ollama service itself keeps running) -------------
if command -v ollama >/dev/null; then
    host=${OLLAMA_HOST:-127.0.0.1:11434}; host=${host#http://}
    loaded=$(curl -s -m 10 "http://$host/api/ps" 2>/dev/null | jq -r '.models[].name' 2>/dev/null)
    for m in $loaded; do
        timeout 20 ollama stop "$m" >/dev/null 2>&1 && log "ollama: unloaded $m"
    done
fi

# --- 2. monitor input (LG, over DDC/CI: see lgmonitor-input) and audio ---------------
# ddc_on is set before the attempt, so a failed switch still tries to switch back on exit.
# The input is whichever one the monitor reaches the eGPU (card1) through; the cable can be
# moved between inputs.
ddc_on=
if command -v lgmonitor-input >/dev/null; then
    input=$(lgmonitor-input find card1 2>/dev/null)
    if [ -z "$input" ]; then
        echo "egpu-kiosk: no monitor input is wired to the eGPU (card1); switch it by hand." >&2
    else
        ddc_on=1
        log "monitor input for the eGPU: $input"
        egpu-audio follow -- lgmonitor-input set "$input" \
            || echo "egpu-kiosk: could not switch the monitor to $input; do it by hand." >&2
    fi
fi

# --- 3. cleanup, however we end (kiosk quit, Ctrl+C, program exit) ----------------------
# Steam keeps running in its tray when its window is closed, which would hold the eGPU and
# block `waybar-egpu disconnect`.
cleanup() {
    if [ "${cmd[0]}" = /usr/games/steam ]; then /usr/games/steam -shutdown >/dev/null 2>&1; fi
    if [ -n "$ddc_on" ]; then
        egpu-audio unfollow -- lgmonitor-input set usbc \
            || echo "egpu-kiosk: could not switch the monitor back; use its input button." >&2
    fi
    log "cleanup done"
}
trap cleanup EXIT

# --- 4. the kiosk -----------------------------------------------------------------------
: > "$SWAYLOG"
KIOSK_CMD=$(printf '%q ' "${cmd[@]}") \
WLR_DRM_DEVICES=/dev/dri/card1 \
WLR_NO_HARDWARE_CURSORS=1 \
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
__GLX_VENDOR_LIBRARY_NAME=nvidia \
sway --unsupported-gpu -c "$CONF" >> "$SWAYLOG" 2>&1
rc=$?
log "sway exited rc=$rc"
exit $rc
