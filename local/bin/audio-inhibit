#!/bin/bash
# Hold an idle inhibitor while audio is playing or being recorded.
#   audio-inhibit             run the inhibit loop
#   audio-inhibit --waybar    JSON status for a waybar custom module
#   audio-inhibit --toggle    enable/disable inhibition (state kept in $XDG_RUNTIME_DIR)
#
# Sway: start at login
#   exec audio-inhibit
#
# Waybar: add "custom/audio-inhibit" to modules-left/center/right, then define it
#   "custom/audio-inhibit": {
#       "return-type": "json",
#       "exec": "~/.local/bin/audio-inhibit --waybar",
#       "on-click": "~/.local/bin/audio-inhibit --toggle",
#       "interval": 1
#   }
#
# Waybar style.css (~/.config/waybar/style.css):
#   #custom-audio-inhibit {
#       padding: 0 10px;
#       transition: background-color 150ms;
#   }
#   #custom-audio-inhibit:hover {
#       background-color: rgba(255, 255, 255, 0.2);  /* click to toggle */
#   }
#   #custom-audio-inhibit.busy {
#       color: #ff5555;  /* audio active: screen will not idle */
#   }
#   #custom-audio-inhibit.free {
#       color: #55ff55;  /* nothing playing or recording */
#   }
#   #custom-audio-inhibit.disabled {
#       color: #888888;  /* inhibition toggled off */
#   }

# Configuration
readonly EXCLUDE_RECORDING_APPS='["parec", "wf-recorder"]'
readonly EXCLUDE_PLAYING_APPS='["speech-dispatcher-dummy"]'
# We default to Font Awesome glyphs
readonly ICON_IDLE=$'\uf017'       # 
readonly ICON_PLAYING=$'\uf144'    # 
readonly ICON_RECORDING=$'\uf590'  # 
readonly POLL_INTERVAL=5
readonly DISABLED_FILE="${XDG_RUNTIME_DIR:-/tmp}/audio-inhibit.disabled"

holder=""

# Streams capturing a sink monitor (level meters, screen-share audio) are not microphones
apps_recording(){
    pactl -f json list source-outputs 2>/dev/null | jq -er \
        --argjson exclude "$EXCLUDE_RECORDING_APPS" \
        --slurpfile sources <(pactl -f json list sources 2>/dev/null) '
        [$sources[0][] | select(.name | endswith(".monitor")) | .index] as $monitors
        | [.[]
        | select(.corked == false)
        | select(.source | IN($monitors[]) | not)
        | select(.properties."application.process.id" != null)
        | select(.properties."application.name" | IN($exclude[]) | not)
        | .properties."application.name" // .properties."media.name" // "unknown app"]
        | unique
        | join(", ")
        '
}

apps_playing(){
    pactl -f json list sink-inputs 2>/dev/null | jq -er \
        --argjson exclude "$EXCLUDE_PLAYING_APPS" '
        [.[]
        | select(.corked == false)
        | select(.mute == false)
        | select(.properties."application.process.id" != null)
        | select(.properties."application.name" | IN($exclude[]) | not)
        | .properties."application.name" // .properties."media.name" // "unknown app"]
        | unique
        | join(", ")
        '
}

disabled(){ [[ -e "$DISABLED_FILE" ]]; }

toggle(){
    if disabled; then rm -f "$DISABLED_FILE"; else touch "$DISABLED_FILE"; fi
}

jsonify() {  # jsonify <text> <class> <tooltip>
    jq -nc --arg text "$1" --arg class "$2" --arg tooltip "$3" \
        '{text: $text, class: $class, tooltip: $tooltip}'
}

show_status(){  # show_status <recording-apps> <playing-apps> <json|quiet>
    local recording="$1" playing="$2" mode="$3"
    local icon class=busy tooltip=""

    [[ -n "$recording" ]] && tooltip="Recording: $recording"
    [[ -n "$playing" ]] && tooltip+="${tooltip:+$'\n'}Playing: $playing"

    # Icon priority: recording (in a call) > playing > idle
    if [[ -n "$recording" ]]; then
        icon="$ICON_RECORDING"
    elif [[ -n "$playing" ]]; then
        icon="$ICON_PLAYING"
    else
        icon="$ICON_IDLE" class=free tooltip="Idle"
    fi

    case "$mode" in
        json)
            if disabled; then
                [[ "$class" == busy ]] && tooltip=$'Idle inhibition disabled\n'"$tooltip" || tooltip="Idle inhibition disabled"
                class=disabled
            fi
            jsonify "$icon" "$class" "$tooltip" ;;
        quiet) [[ "$class" == busy ]] && return 0 || return 1 ;;
    esac
}

acquire(){
    systemd-inhibit --what=idle --who="${0##*/}" --why="Audio active" sleep infinity &
    holder=$!
}

release(){
    [[ -n "$holder" ]] && kill "$holder" 2>/dev/null
    holder=""
}

# Hold an idle inhibitor (screen lock, suspend) while audio is active, unless toggled off
inhibit_loop(){
    trap release EXIT
    trap 'exit' INT TERM

    while true; do
        if ! disabled && show_status "$(apps_recording)" "$(apps_playing)" quiet; then
            [[ -z "$holder" ]] && acquire
        else
            release
        fi

        sleep "$POLL_INTERVAL"
    done
}

main(){
    case "${1:-}" in
        "") inhibit_loop ;;
        --waybar) show_status "$(apps_recording)" "$(apps_playing)" json ;;
        --toggle) toggle ;;
        *) echo "Usage: ${0##*/} [--waybar|--toggle]" >&2; exit 1 ;;
    esac
}

main "$@"
