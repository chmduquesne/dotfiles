#!/bin/bash
# sandbox-bridge [claude|opencode]: run the make targets a sandboxed agent asks for, after you
# approve them. Start it at the root of the project's git repository, in another terminal, next
# to claude-sandboxed or opencode-sandboxed. It waits for a sandbox container whose /src is that
# directory or one of its parents (the sandbox may have been started higher up), and exits when
# that container stops.
#
# The agent appends requests to make-queue.txt, one per line: a target, then optional VAR=value
# arguments (for example `test FILTER=parser` or `sql Q="select 1"`). The target matches
# [a-z][a-z0-9_-]*, variable names [A-Z][A-Z0-9_]*, and a value is a bare word
# [A-Za-z0-9_./:,@+-]* or text in single or double quotes (no escapes inside, no control
# characters). Variables that change how make or the shell behave are refused (see deny below).
# Values are passed to make as single arguments, never through a shell of the bridge, but a
# recipe that uses $(VAR) puts it in a shell command line: that is what the prompt is for. Requests
# already in the queue when the bridge starts are ignored.
#
# For each request you see the target and a diff of what changed in the project since you last
# approved something (the first time: since HEAD), and answer y/n. On y it runs
# `make <target> <vars>` with a clean environment: only PATH, HOME, USER, LANG, TERM and
# XDG_RUNTIME_DIR, killed after SANDBOX_BRIDGE_TIMEOUT seconds (default 600). Commands that do
# not end (tunnels, servers) are for you to run in your own terminal, not through the bridge.
# The agent reads the result in make-output/<target>.txt, which its Makefile
# is expected to write; the bridge deletes the old one first, and appends `done <target>
# exit=<code>`, `declined <target>` or `rejected` to make-output/_bridge.txt.
#
# What this does NOT protect against: the agent writes the Makefile, so an approved target
# runs agent-written code on the host. Read the diff. Files ignored by git (node_modules, .env,
# ignored scripts) are not in the diff, and a long make can read files the agent changes while
# it runs. The tree is checked again just before running, which only closes the window before
# the start.

queue=make-queue.txt
outdir=make-output
# excluded from the diff: they change all the time and are not code
excluded=(make-queue.txt make-output .claude-sandbox .opencode-sandbox)
excludes=("${excluded[@]/#/:!}")
# variable names that are refused (edit to taste)
deny='SHELL|SHELLOPTS|BASHOPTS|MAKE.*|PATH|HOME|USER|LD_.*|BASH_ENV|ENV|IFS|PS4|CDPATH|PYTHON.*|NODE_OPTIONS|GIT_.*|XDG_.*|TMPDIR|DOCKER_.*|CONTAINER_.*|LANG|LC_.*|TERM'

AGENT="${1:-claude}"
container=
scratch=
base=
seen=0

# print the name of a running sandbox container whose /src is $PWD or one of its parents
find_container(){
	local name src
	for name in $(podman ps --format '{{.Names}}' --filter "name=-$AGENT\$"); do
		src="$(podman inspect --format '{{range .Mounts}}{{if eq .Destination "/src"}}{{.Source}}{{end}}{{end}}' "$name")"
		if [[ $PWD == "$src" || $PWD == "$src"/* ]]; then
			echo "$name"
			return 0
		fi
	done
	return 1
}

# The bridge's git work happens in a scratch git directory, not in .git: if the agent can write
# .git (it can when the sandbox was started above the repository), its .git/config could name
# programs (core.fsmonitor, core.pager, filter and diff drivers) that git would run on the host
# at the first `git add`, before you approve anything. The scratch directory has a clean
# config and borrows the objects of the repository through alternates.
scratch_git(){
	GIT_DIR="$scratch/git" GIT_WORK_TREE="$PWD" "$@"
}

# print the git tree of the project as it is now
tree(){
	rm -f "$scratch/index"
	# the excluded paths are dropped from the index afterwards: as add arguments, git complains
	# about those that .gitignore also lists
	export GIT_INDEX_FILE="$scratch/index"
	scratch_git git add -A -- . > /dev/null &&
		scratch_git git rm -r -q --cached --ignore-unmatch -- "${excluded[@]}" &&
		scratch_git git write-tree
}

# append a status line for the agent, unless make-output is not a plain directory
log(){
	[[ -L $outdir || -L $outdir/_bridge.txt ]] && return
	mkdir -p "$outdir" && printf '%s\n' "$*" >> "$outdir/_bridge.txt"
}

# parse a request line into $target and $vars; fails if it does not comply
parse(){
	local rest name raw value trailing
	local re_target='^[[:space:]]*([a-z][a-z0-9_-]*)(.*)$'
	local re_var='^[[:space:]]+([A-Z][A-Z0-9_]*)=("([^"]*)"|'"'"'([^'"'"']*)'"'"'|([A-Za-z0-9_./:,@+-]*))(.*)$'
	target=
	vars=()
	(( ${#1} <= 2000 )) || return 1
	[[ $1 != *[[:cntrl:]]* ]] || return 1
	[[ $1 =~ $re_target ]] || return 1
	target="${BASH_REMATCH[1]}"
	rest="${BASH_REMATCH[2]}"
	while [[ -n ${rest//[[:space:]]/} ]]; do
		[[ $rest =~ $re_var ]] || return 1
		# (copy the groups first: the next [[ =~ ]] overwrites BASH_REMATCH)
		name="${BASH_REMATCH[1]}"
		raw="${BASH_REMATCH[2]}"
		trailing="${BASH_REMATCH[6]}"
		if [[ $raw == \"* ]]; then
			value="${BASH_REMATCH[3]}"
		elif [[ $raw == \'* ]]; then
			value="${BASH_REMATCH[4]}"
		else
			value="${BASH_REMATCH[5]}"
		fi
		[[ $name =~ ^($deny)$ ]] && return 1
		# a value must be followed by a space or the end of the line
		[[ -z $trailing || $trailing == [[:space:]]* ]] || return 1
		vars+=("$name=$value")
		rest="$trailing"
	done
}

handle(){
	local line="$1" target vars var value margs cur answer rc
	[[ -z ${line//[[:space:]]/} ]] && return

	if ! parse "$line"; then
		printf '\nrejected: %q\n' "${line:0:200}"
		log "rejected"
		return
	fi

	cur="$(tree)" || { echo "cannot compute the project tree, skipping $target"; return; }
	# values are shown quoted, so that what make receives is unambiguous
	printf '\nRequest: make %s' "$target"
	for var in "${vars[@]}"; do value="${var#*=}"; printf ' %s=%s' "${var%%=*}" "${value@Q}"; done
	echo
	if [[ $cur == "$base" ]]; then
		echo "No changes since your last approval."
	else
		scratch_git git diff --stat "$base" "$cur" -- . "${excludes[@]}"
	fi

	while :; do
		read -rp "[y]es / [n]o / [d]iff? " answer || exit 0
		case $answer in
			y|yes) break ;;
			n|no) log "declined $target"; return ;;
			d|diff) scratch_git git diff --color=always "$base" "$cur" -- . "${excludes[@]}" | ${PAGER:-less -R} ;;
		esac
	done

	if [[ "$(tree)" != "$cur" ]]; then
		echo "The project changed after you looked at it: skipped, the agent can ask again."
		log "declined $target (changed)"
		return
	fi
	if [[ -L $outdir ]]; then
		echo "$outdir is a symlink: refusing to run."
		log "declined $target"
		return
	fi

	base="$cur"
	rm -f "$outdir/$target.txt"
	# make expands $ in command line values (even $(shell ...)): double them to keep them literal
	margs=()
	for var in "${vars[@]}"; do value="${var#*=}"; margs+=("${var%%=*}=${value//\$/\$\$}"); done
	# a target that does not end (a tunnel, a server) must not block the bridge: it is killed
	# after $SANDBOX_BRIDGE_TIMEOUT seconds, and the agent sees exit=124
	timeout -k 10 "${SANDBOX_BRIDGE_TIMEOUT:-600}" \
		env -i PATH="$PATH" HOME="$HOME" USER="$USER" LANG="${LANG:-C.UTF-8}" TERM="${TERM:-dumb}" \
		XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" make "$target" "${margs[@]}" < /dev/null
	rc=$?
	(( rc == 124 )) && echo "$target did not finish in ${SANDBOX_BRIDGE_TIMEOUT:-600}s: killed."
	log "done $target exit=$rc"
}

main(){
	local content lines n i

	git rev-parse --show-toplevel > /dev/null 2>&1 || { echo "Not in a git repository" >&2; exit 1; }
	[[ "$(git rev-parse --show-toplevel)" == "$PWD" ]] || { echo "Run it at the root of the repository" >&2; exit 1; }

	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	git init -q --bare "$scratch/git" || exit 1
	echo "$(git rev-parse --absolute-git-dir)/objects" > "$scratch/git/objects/info/alternates"
	# the first request is compared with HEAD, or with nothing in a repository without commits
	base="$(git rev-parse --verify -q 'HEAD^{tree}' || git hash-object -t tree /dev/null)"

	echo "Waiting for a $AGENT sandbox on $PWD..."
	until container="$(find_container)"; do sleep 1; done
	echo "$container is up."

	[[ -f $queue && ! -L $queue ]] && seen="$(wc -l < "$queue")"

	while podman container exists "$container"; do
		if [[ -f $queue && ! -L $queue ]]; then
			# a bounded read, and only complete lines: the agent may be in the middle of a write
			content="$(head -c 65536 "$queue"; echo x)"
			content="${content%x}"
			if [[ $content != *$'\n' ]]; then
				[[ $content == *$'\n'* ]] && content="${content%$'\n'*}"$'\n' || content=
			fi
			mapfile -t lines <<< "${content%$'\n'}"
			[[ -z $content ]] && lines=()
			n=${#lines[@]}
			(( n < seen )) && seen=0
			for ((i = seen; i < n; i++)); do
				handle "${lines[i]}"
			done
			seen=$n
		fi
		sleep 1
	done
	echo "$container stopped."
}

main
