#!/bin/bash
# waybar-apt: pending apt updates for waybar.
#
# The count comes from simulating a dist-upgrade against the local package lists, which only
# change on `apt update`. The lists' age is read from a stamp file.
#
# Setup: have apt refresh the lists daily and stamp each successful refresh. Put this in
# /etc/apt/apt.conf.d/20update-package-lists:
#   APT::Periodic::Update-Package-Lists "1";
#   APT::Update::Post-Invoke-Success { "touch /var/lib/apt/periodic/update-success-stamp"; };
# The first line makes apt-daily.timer run `apt update` once a day (without it the timer does
# nothing); the second writes the stamp. Without the stamp, the tooltip has no age line.

# Usage: waybar-apt status|update|upgrade
#   status   print the waybar JSON
#   update   run `sudo apt update` in a terminal (waybar left click), then refresh the module
#   upgrade  run `sudo apt upgrade` in a terminal (waybar right click), then refresh the module
#
# Keep TERMINAL in sync with `set $term` in config/sway/config.
TERMINAL=gnome-terminal
WAYBAR_SIGNAL=10    # must match "signal" of custom/updates in config/waybar/config

STAMP=/var/lib/apt/periodic/update-success-stamp
MAX_NAMES=15

waybar_emit() {
    jq -nc --arg text "$1" --arg class "$2" --arg tooltip "$3" \
        '{text: $text, class: $class, alt: $class, tooltip: $tooltip}'
}

# "3 hours ago" for the age of $STAMP; prints nothing if there is no stamp.
lists_age() {
    local secs
    [ -e "$STAMP" ] || return 0
    secs=$(( $(date +%s) - $(stat -c %Y "$STAMP") ))
    if   [ "$secs" -ge 86400 ]; then echo "$((secs / 86400)) days ago"
    elif [ "$secs" -ge 3600 ];  then echo "$((secs / 3600)) hours ago"
    else echo "$((secs / 60)) minutes ago"
    fi
}

# Run `sudo apt $1` in a terminal that stays open until a key is pressed, then refresh waybar.
apt_in_terminal() {
    "$TERMINAL" --wait -- bash -c "sudo apt $1; echo; read -n 1 -s -r -p 'Press any key to close'"
    pkill -RTMIN+"$WAYBAR_SIGNAL" waybar
}

case "$1" in
    status) ;;
    update|upgrade) apt_in_terminal "$1"; exit 0 ;;
    *) echo "usage: ${0##*/} status|update|upgrade" >&2; exit 1 ;;
esac

plan=$(apt-get -q -s dist-upgrade 2>&1) || { waybar_emit "?" error "apt-get failed: ${plan##*$'\n'}"; exit 0; }

names=$(awk '/^Inst/ {print $2}' <<< "$plan")
count=$(awk '/^Inst/ {n++} END {print n + 0}' <<< "$plan")

if [ "$count" -eq 0 ]; then
    class=updated
    tooltip="All packages are up to date"
else
    class=has-updates
    tooltip="$count updates available (left click: update lists, right click: upgrade)"$'\n\n'$(head -n "$MAX_NAMES" <<< "$names")
    [ "$count" -gt "$MAX_NAMES" ] && tooltip+=$'\n'"... and $((count - MAX_NAMES)) more"
fi

age=$(lists_age)
[ -n "$age" ] && tooltip+=$'\n\n'"Lists refreshed $age"

waybar_emit "$count" "$class" "$tooltip"
